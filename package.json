{
  "name": "dsh-stellar-effort",
  "version": "1.1.5",
  "description": "星轨推理：真实 DSH 推理强度控制与轻量、持续演化的微缩宇宙",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning-effort",
    "webgl",
    "black-hole"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangtheme-coder/dsh-stellar-effort.git"
  },
  "homepage": "https://github.com/wangtheme-coder/dsh-stellar-effort#readme",
  "bugs": {
    "url": "https://github.com/wangtheme-coder/dsh-stellar-effort/issues"
  },
  "type": "module",
  "main": "./src/host.mjs",
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src",
    "dist",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "ASSETS_CREDITS.md",
    "release-manifest.json",
    "install.cmd",
    "uninstall.cmd"
  ],
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "pack:release": "node scripts/package.mjs",
    "test:browser": "node scripts/browser-qa.mjs",
    "test:space": "node scripts/space-qa.mjs",
    "test:hole": "node scripts/hole-qa.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
